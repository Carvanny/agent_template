APP_NAME=Sales Assistant Agent
BRAND_NAME=Sua Empresa
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
COMMUNICATION_PROVIDER=waha

GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.0-flash
LLM_PROVIDER=gemini
OPENAI_LIKE_BASE_URL=
OPENAI_LIKE_API_KEY=
OPENAI_LIKE_MODEL=
COUNTRY_LANGUAGE_MAP=55:pt,595:es

# Quando rodar localmente sem Docker: redis://localhost:6379/0
# Quando rodar via docker compose: substituído automaticamente pelo serviço app
REDIS_URL=redis://:change-me@localhost:6379/0
REDIS_TTL_SECONDS=86400
REDIS_DEDUP_TTL_SECONDS=300

# Senha usada pelo container Redis (docker compose)
REDIS_PASSWORD=change-me

SQLITE_DB_PATH=./db/assistant.db

# Quando rodar localmente sem Docker: http://localhost:3000
# Quando rodar via docker compose: substituído automaticamente pelo serviço app
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=change-me
WAHA_WEBHOOK_SECRET=change-me
ALLOW_WEBHOOK_QUERY_SECRET=false
ALLOW_UNAUTHENTICATED_WEBHOOK=false
WAHA_SESSION_NAME=default
WAHA_DOWNLOAD_TIMEOUT_SECONDS=20
WAHA_MAX_AUDIO_BYTES=8000000
WHATSAPP_HOOK_URL=http://host.docker.internal:8000/webhook/waha
WHATSAPP_DEFAULT_ENGINE=GOWS
WHATSAPP_HOOK_EVENTS=message
# Opcional: sobrescreve o header enviado pelo WAHA para o webhook
# WHATSAPP_HOOK_CUSTOM_HEADERS=x-webhook-secret:change-me
WAHA_DEBUG=false
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-me

FAQ_URL=https://example.com/faq.html

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

LEAD_FINALIZATION_MIN_FIELDS=5
SESSION_SUMMARY_MAX_CHARS=1500
LLM_MAX_RETRIES=2
HTTPX_TIMEOUT_SECONDS=10
HTTPX_MAX_RETRIES=2

# HTTP provider (COMMUNICATION_PROVIDER=http)
COMM_HTTP_SEND_TEXT_URL=
COMM_HTTP_SEND_SEEN_URL=
COMM_HTTP_HEADERS=
COMM_HTTP_TIMEOUT_SECONDS=10
COMM_HTTP_MAX_AUDIO_BYTES=8000000
