APP_NAME=Sleeping Center Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Agent / LLM
LLM_PROVIDER=lmstudio
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-key-api
GEMINI_MODEL=models/gemini-2.5-flash-lite
GEMINI_API_KEY=sk-key-api
OPENAI_LIKE_BASE_URL=http://192.168.100.20:1234/v1
OPENAI_LIKE_MODEL=meta-llama-3-8b-instruct
OPENAI_LIKE_API_KEY=

REDIS_URL=redis://:localhost@localhost:6379/0
REDIS_TTL_SECONDS=86400
REDIS_DEDUP_TTL_SECONDS=300
REDIS_PASSWORD=password-local

SQLITE_DB_PATH=./db/sleeping_center.db

WAHA_BASE_URL=http://localhost:3000
WAHA_WEBHOOK_SECRET=key-pass
WAHA_SESSION_NAME=default
WAHA_DOWNLOAD_TIMEOUT_SECONDS=20
WAHA_MAX_AUDIO_BYTES=8000000
WHATSAPP_HOOK_URL=http://host.docker.internal:8000/webhook/waha
WHATSAPP_HOOK_CUSTOM_HEADERS=x-webhook-secret:passkey
ALLOW_WEBHOOK_QUERY_SECRET=false
ALLOW_UNAUTHENTICATED_WEBHOOK=true
WHATSAPP_DEFAULT_ENGINE=GOWS
WHATSAPP_HOOK_EVENTS=message
WAHA_API_KEY=api-key-waha
WAHA_DEBUG=false
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=psw-pass
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=<config>

FAQ_URL=https://example.com/faq.html

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

LEAD_FINALIZATION_MIN_FIELDS=5
SESSION_SUMMARY_MAX_CHARS=1500
LLM_MAX_RETRIES=2
HTTPX_TIMEOUT_SECONDS=10
HTTPX_MAX_RETRIES=2
